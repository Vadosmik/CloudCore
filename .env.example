# delete .example from the filename and rename it to .env

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=database
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=a-string-secret-at-least-256-bits-long
JWT_ALGORITHM=HS256
JWT_EXPIRATION=30
REFRESH_TOKEN_EXPIRATION=10080

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@admin.com
INITIAL_ADMIN_PASSWORD=admin123

# shared key between core-service and collectors (X-Internal-Key header)
# generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=change_me_internal_key
